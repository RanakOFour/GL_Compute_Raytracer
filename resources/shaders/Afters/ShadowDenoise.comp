#version 430 core

// Cross-bilateral filtering for shadows

layout(local_size_x = 8, local_size_y = 4) in;

layout(rgba32f, binding = 0) uniform image2D o_framebufferTex;


layout(rgba32f, binding = 2) uniform image2D hitNormals;

layout(rgba32f, binding = 4) uniform image2D shadowBuffer;

void main()
{
    ivec2 l_pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    vec3 b_normal = imageLoad(hitNormals, l_pixelCoords).xyz;
    vec3 b_frameShadow = imageLoad(shadowBuffer, l_pixelCoords).xyz;

    vec3 l_filteredShadow = vec3(0.0);
    float l_totalWeight = 0.0;

    for(int dx = -1; dx <= 1; dx++)
    {
        for(int dy = -1; dy <= 1; dy++)
        {
            ivec2 l_sampleCoord = l_pixelCoords + ivec2(dx, dy);
            vec3 l_sampleShadow = imageLoad(shadowBuffer, l_sampleCoord).xyz;
            vec3 l_sampleNormal = imageLoad(hitNormals, l_sampleCoord).xyz;
            
            float l_normalWeight = max(0.0, dot(b_normal, l_sampleNormal));
            float l_spatialWeight = 1.0 / (1.0 + float(dx*dx + dy*dy));
            
            float l_weight = l_normalWeight * l_spatialWeight;
            l_filteredShadow += l_sampleShadow * l_weight;
            l_totalWeight += l_weight;
        }
    }

    if(l_totalWeight > 0.0)
    {
        b_frameShadow = l_filteredShadow / l_totalWeight;
    }

    imageStore(shadowBuffer, l_pixelCoords, vec4(b_frameShadow, 1.0f));
}