#version 430 core

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D framebufferTex;

uniform vec3 cameraPos;
uniform vec3 cameraForward;
uniform vec3 cameraRight;
uniform vec3 cameraUp;
uniform float fov;
uniform vec2 resolution;

struct Light
{
    vec3 color;
    vec3 position;
};

#define MAX_LIGHTS 10
uniform Light lights[MAX_LIGHTS];
uniform int numLights;

struct Sphere 
{
    vec3 position;
    float radius;
    vec3 color;
};

#define MAX_SPHERES 10
uniform Sphere spheres[MAX_SPHERES];
uniform int numSpheres;

struct Cube 
{
    vec3 position;
    vec3 size;
    vec3 color;
};

#define MAX_CUBES 10
uniform Cube cubes[MAX_CUBES];
uniform int numCubes;

struct Ray 
{
    vec3 origin;
    vec3 direction;
};

struct RaycastResult 
{
    bool hit;
    float distance;
    vec3 position;
    vec3 normal;
    int objectIndex;
    bool isSphere; // true for sphere, false for cube
};

RaycastResult intersectSphere(Ray ray, Sphere sphere, int index)
{
    RaycastResult result;
    result.hit = false;
    result.objectIndex = index;
    result.isSphere = true;
    
    vec3 oc = ray.origin - sphere.position;
    float a = dot(ray.direction, ray.direction);
    float b = 2.0 * dot(oc, ray.direction);
    float c = dot(oc, oc) - sphere.radius * sphere.radius;
    
    float discriminant = b * b - 4.0 * a * c;
    
    if (discriminant < 0.0)
    {
        return result;
    }
    
    float sqrtDisc = sqrt(discriminant);
    float t1 = (-b - sqrtDisc) / (2.0 * a);
    float t2 = (-b + sqrtDisc) / (2.0 * a);
    
    float t = (t1 > 0.0) ? t1 : t2;
    if (t <= 0.0)
    {
        return result;
    }
    
    result.hit = true;
    result.distance = t;
    result.position = ray.origin + t * ray.direction;
    result.normal = normalize(result.position - sphere.position);
    
    return result;
}

RaycastResult intersectCube(Ray ray, Cube cube, int index)
{
    RaycastResult result;
    result.hit = false;
    result.objectIndex = index;
    result.isSphere = false;
    
    vec3 cubeMin = cube.position - cube.size * 0.5;
    vec3 cubeMax = cube.position + cube.size * 0.5;
    
    vec3 invDir = 1.0 / ray.direction;
    vec3 t0 = (cubeMin - ray.origin) * invDir;
    vec3 t1 = (cubeMax - ray.origin) * invDir;
    
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);
    
    float tnear = max(max(tmin.x, tmin.y), tmin.z);
    float tfar = min(min(tmax.x, tmax.y), tmax.z);
    
    if (tnear > tfar || tfar < 0.0)
    {
        return result;
    }
    
    result.hit = true;
    result.distance = tnear;
    result.position = ray.origin + tnear * ray.direction;
    
    // Calculate normal based on which face was hit
    vec3 localPos = (result.position - cube.position) / cube.size;
    vec3 absPos = abs(localPos);
    
    if (absPos.x > absPos.y && absPos.x > absPos.z)
    {
        result.normal = vec3(sign(localPos.x), 0.0, 0.0);
    }
    else if (absPos.y > absPos.z)
    {
        result.normal = vec3(0.0, sign(localPos.y), 0.0);
    }
    else
    {
        result.normal = vec3(0.0, 0.0, sign(localPos.z));
    }
    
    return result;
}

bool isInShadow(vec3 lightPos, RaycastResult raycastHit)
{
    Ray shadowRay;
    shadowRay.origin = raycastHit.position + raycastHit.normal * 0.001;
    shadowRay.direction = normalize(lightPos - raycastHit.position);
    
    float lightDistance = length(lightPos - raycastHit.position);
    
    // Check if any sphere blocks the path to light
    for (int i = 0; i < numSpheres; i++)
    {
        if (raycastHit.isSphere && i == raycastHit.objectIndex)
        {
            continue;
        }
        
        RaycastResult shadowHit = intersectSphere(shadowRay, spheres[i], i);
        if (shadowHit.hit && shadowHit.distance < lightDistance)
        {
            return true;
        }
    }

    // Check if any cube blocks the path to light
    for (int i = 0; i < numCubes; i++)
    {
        if (!raycastHit.isSphere && i == raycastHit.objectIndex)
        {
            continue;
        }
        
        RaycastResult shadowHit = intersectCube(shadowRay, cubes[i], i);
        if (shadowHit.hit && shadowHit.distance < lightDistance)
        {
            return true;
        }
    }
    
    return false;
}


vec3 getObjectColor(RaycastResult hit)
{
    if (hit.isSphere)
    {
        return spheres[hit.objectIndex].color;
    }
    else
    {
        return cubes[hit.objectIndex].color;
    }
}

vec3 calculateShading(RaycastResult hit, Ray ray)
{
    if (!hit.hit)
    {
        return vec3(0.1, 0.1, 0.3); // Background color
    }
    
    vec3 objectColor = getObjectColor(hit);
    vec3 lighting = vec3(0.0);

    for(int i = 0; i < numLights; i++)
    {
        // Check if point is in shadow for this light
        if (isInShadow(lights[i].position, hit))
        {
            continue;
        }
        
        // Calculate direction from hit point to light
        vec3 lightDir = normalize(lights[i].position - hit.position);

        // Diffuse component
        float diffuse = max(dot(hit.normal, lightDir), 0.0);
        vec3 diffuseColor = lights[i].color * objectColor * diffuse;

        // Specular component
        vec3 viewDir = normalize(cameraPos - hit.position);
        vec3 reflectDir = reflect(-lightDir, hit.normal);
        float specular = pow(max(dot(viewDir, reflectDir), 0.0), 32.0);
        vec3 specularColor = lights[i].color * specular;

        // Add attenuation based on distance
        float distance = length(lights[i].position - hit.position);
        float attenuation = 1.0 / (1.0 + 0.1 * distance + 0.01 * distance * distance);
        
        lighting += (diffuseColor + specularColor) * attenuation;
    };
    
    // Add ambient lighting (always present, even in shadows)
    vec3 ambient = objectColor * 0.1;
    
    return ambient + lighting;
}

void main() 
{
    // Normalize coords from -1.0 to 1.0
    vec2 uv = vec2(((float(gl_GlobalInvocationID.x) / gl_NumWorkGroups.x) - 0.5f) * 2.0f,
                   ((float(gl_GlobalInvocationID.y) / gl_NumWorkGroups.y) - 0.5f) * 2.0f);

    float aspect = resolution.x / resolution.y;
    vec3 rayDir = normalize(cameraForward + 
                           uv.x * cameraRight * fov * aspect + 
                           uv.y * cameraUp * fov);
    
    Ray ray;
    ray.origin = cameraPos;
    ray.direction = rayDir;
    
    RaycastResult closestHit;
    closestHit.hit = false;
    closestHit.distance = 1e10;
    
    // Check spheres
    for (int i = 0; i < numSpheres; i++)
    {
        RaycastResult hit = intersectSphere(ray, spheres[i], i);
        if (hit.hit && hit.distance < closestHit.distance)
        {
            closestHit = hit;
        }
    }
    
    // Check cubes
    for (int i = 0; i < numCubes; i++)
    {
        RaycastResult hit = intersectCube(ray, cubes[i], i);
        if (hit.hit && hit.distance < closestHit.distance)
        {
            closestHit = hit;
        }
    }

    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    imageStore(framebufferTex, position, vec4(calculateShading(closestHit, ray), 1.0));
}