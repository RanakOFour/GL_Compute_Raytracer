#version 430 core

layout(local_size_x = 8, local_size_y = 4) in;
layout(rgba32f, binding = 0) uniform image2D o_framebufferTex;

layout(rgba32f, binding = 1) uniform image2D hitLocations;
layout(rgba32f, binding = 2) uniform image2D triangleNormals;

layout(rgba32f, binding = 4) uniform image2D shadowBuffer;
layout(rgba32ui, binding = 5) uniform uimage2D randomBuffer;


struct Triangle
{
    // Vertex positions
    vec3 a;
    vec3 b;
    vec3 c;
    vec3 normal;

    // UV Coordinates for each vertex
    vec2 uvA;
    vec2 uvB;
    vec2 uvC;

    int textureId;
    int materialId;
};

layout(std430, binding = 6) readonly buffer b_trianglesSSBO
{
    Triangle sceneTris[];
};

struct Node
{
    // Laid out like this for bit packing
    vec3 minBound;

    // Holds index of left node (if not leaf node) or first triangle (if leaf node)
    int leftFirst;
    vec3 maxBound;

    // Triangles in node (0 if not leaf node)
    int triangleCount;
};

layout(std430, binding = 7) readonly buffer b_bvhNodes
{
    Node bvhNodes[];
};

// Maps bvhNode.leftFirst indexes to indexes in sceneTris
layout(std430, binding = 8) readonly buffer b_bvhTriangleId
{
    int bvhTriIdxs[];
};

#define MAX_LIGHTS 10
struct Light
{
    vec3 points[4];
    vec3 colour;
    float intensity;
    float radius;
};

uniform Light u_lights[MAX_LIGHTS];
uniform int u_lightCount;

uniform int u_samplesPerLight;

uniform int u_frameCount;

uniform float u_temporalDecay;

struct Ray  { vec3 origin; vec3 direction; };

struct RaycastResult {
    bool hit;
    float distance;
    vec3 position;
    vec3 normal;
    int triangleId;
};

const float PI = 3.14159265359;

// A "random" function I found in a stack overflow comment section

// Used to advance the PCG state.
uint Rand_pcg(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// Random number between 0 and 1
float Rand01(inout uint state)
{
    return float(Rand_pcg(state)) / 4294967295.0;
}

vec3 SamplePointOnSphere(inout uint rng_state, vec3 center, float radius)
{
    float u = (Rand01(rng_state) - 0.5f) * 2.0f;
    float v = (Rand01(rng_state) - 0.5f) * 2.0f;

    // Turn random numbers into cosine distribution
    float theta = 2.0 * PI * u;
    float phi = PI * v;

    vec3 dir = normalize(vec3(
                                cos(theta) * sin(phi),
                                sin(theta) * sin(phi),
                                cos(phi)
                             ));
    return center + dir * radius;
}

vec3 SamplePointOnPlane(inout uint rng_state, vec3 _corner, vec3 _edge1, vec3 _edge2)
{
    float u = Rand01(rng_state);
    float v = Rand01(rng_state);

    return _corner + u * _edge1 + v * _edge2;
}

RaycastResult TriangleIntersect(Ray _ray, Triangle _tri, int _index)
{
    RaycastResult result;
    result.hit = false;
    result.triangleId = _index;

    const float l_ep = 0.000001;
    
    vec3 edge1 = _tri.b - _tri.a;
    vec3 edge2 = _tri.c - _tri.a;
    
    vec3 h = cross(_ray.direction, edge2);
    float det = dot(edge1, h);
    
    // If the determinant is negative, the triangle is back-facing.
    if (det < l_ep)
    {
        return result;
    }
    
    float invDet = 1.0 / det;
    vec3 s = _ray.origin - _tri.a;
    float u = invDet * dot(s, h);
    
    if (u < 0.0 || u > 1.0)
    {
        return result;
    }
    
    vec3 q = cross(s, edge1);
    float v = invDet * dot(_ray.direction, q);
    
    if (v < 0.0 || u + v > 1.0)
    {
        return result;
    }
    
    // At this stage we can compute t to find out where
    // the intersection point is on the line
    float t = invDet * dot(edge2, q);
    
    if (t > l_ep) // Ray intersection
    {
        result.hit = true;
        result.position = _ray.origin + _ray.direction * t;
        result.distance = t;
        result.normal = normalize(cross(edge1, edge2));
        return result;
    }
    
    // This means that there is a line intersection but not a ray intersection
    return result;
}

bool IntersectAABB(inout Ray _ray, vec3 _minBound, vec3 _maxBound)
{
    float tmin = 0.0f;
    float tmax = 10000000.0f;

    for (int i = 0; i < 3; i++)
    {
        if (abs(_ray.direction[i]) < 0.0001f)
        {
            if (_ray.origin[i] < _minBound[i] || _ray.origin[i] > _maxBound[i])
                return false;
        }
        else
        {
            float ood = 1.0f / _ray.direction[i];
            float t1 = (_minBound[i] - _ray.origin[i]) * ood;
            float t2 = (_maxBound[i] - _ray.origin[i]) * ood;

            if (t1 > t2)
            {
                float temp = t1;
                t1 = t2;
                t2 = temp;
            }

            tmin = max(tmin, t1);
            tmax = min(tmax, t2);

            if (tmin > tmax)
            {
                return false;
            }
        }
    }

    return true;
}

// Shadow ray tracing (simplified version of TraverseBVH)
bool IsInShadow(vec3 _lightPos, vec3 _position, vec3 _normal, int _idx, inout vec3 _error)
{
    Ray l_shadowRay;
    l_shadowRay.origin = _position + _normal * 0.01;
    l_shadowRay.direction = normalize(_lightPos - _position);
    
    float l_lightDistance = length(_lightPos - _position);
    
    int l_indexStack[64];
    int l_top = 0;
    l_indexStack[l_top] = 0;

    Node l_node = bvhNodes[l_indexStack[l_top]];
    l_top++;

    do
    {
        if(IntersectAABB(l_shadowRay, l_node.minBound, l_node.maxBound))
        {
            _error += vec3(0.02, 0.0, 0.0);
            if(l_node.triangleCount > 0)
            {
                for(int i = 0; i < l_node.triangleCount; i++)
                {
                    _error += vec3(0.0, 0.0, 0.01);
                    int triIdx = bvhTriIdxs[l_node.leftFirst + i];
                    RaycastResult newResult = TriangleIntersect(l_shadowRay, sceneTris[triIdx], triIdx);
                    if(newResult.hit && newResult.distance < l_lightDistance)
                    {
                        _error += vec3(0.0, 0.5, 0.00);
                        return true;
                    }
                }
            }
            else
            {
                l_indexStack[l_top] = l_node.leftFirst;
                l_top++;
                l_indexStack[l_top] = l_node.leftFirst + 1;
                l_top++;
            }
        }

        
        l_top--;
        l_node = bvhNodes[l_indexStack[l_top]];
    } while(l_top > -1);

    return false;
}

void main() {
    ivec2 l_pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    
    // Load geometry
    vec3 b_hitLocation = imageLoad(hitLocations, l_pixelCoords).xyz;
    float b_hitDistance = imageLoad(hitLocations, l_pixelCoords).w;
    
    if (b_hitDistance < 0.001)
    {
        // Background: fully lit
        imageStore(shadowBuffer, l_pixelCoords, vec4(1.0, 1.0, 1.0, 1.0));
        return;
    }
    
    int b_triId = int(imageLoad(triangleNormals, l_pixelCoords).w);
    Triangle l_hitTriangle = sceneTris[b_triId];
    
    // Load previous frame's SHADOW visibility (0=shadow, 1=lit)
    vec4 b_preData = imageLoad(shadowBuffer, l_pixelCoords);
    vec3 prevVisibility = b_preData.rgb;
    float b_sampleCount = b_preData.a;
    
    uint b_rng = imageLoad(randomBuffer, l_pixelCoords).r;
    if (b_rng == 0u || u_frameCount == 0)
    {
        b_rng = uint(l_pixelCoords.x * 1973 + l_pixelCoords.y * 9277 + u_frameCount);
    }
    
    // Calculate shadow visibility for this frame
    vec3 newVisibility = vec3(0.0);
    int testsDone = 0;
    
    for(int lightIdx = 0; lightIdx < u_lightCount; lightIdx++)
    {
        float lightVisible = 0.0;
        
        // Test shadow with one sample per light (for now)
        uint sampleRNG = b_rng ^ uint(lightIdx * 10007);
        
        // Sample point on light
        vec3 lightSample;
        if (u_lights[lightIdx].radius > 0.0)
        {
            // Sphere light
            float u = Rand01(sampleRNG) * 2.0 - 1.0;
            float v = Rand01(sampleRNG) * 2.0 - 1.0;
            float theta = 2.0 * PI * u;
            float phi = acos(2.0 * v - 1.0);
            lightSample = u_lights[lightIdx].points[0] + 
                          u_lights[lightIdx].radius * vec3(
                             sin(phi) * cos(theta),
                             sin(phi) * sin(theta),
                             cos(phi)
                         );
        }
        else
        {
            // Quad light - sample uniformly
            vec3 edge1 = normalize(u_lights[lightIdx].points[1] - u_lights[lightIdx].points[0]);
            vec3 edge2 = normalize(u_lights[lightIdx].points[2] - u_lights[lightIdx].points[0]);
            float u = Rand01(sampleRNG);
            float v = Rand01(sampleRNG);
            lightSample = u_lights[lightIdx].points[0] + u * edge1 + v * edge2;
        }
        
        // Simple shadow test (returns true if in shadow)
        vec3 biasNormal = l_hitTriangle.normal;
        vec3 error = vec3(0.0);
        if (!IsInShadow(lightSample, b_hitLocation, biasNormal, b_triId, error))
        {
            // Not in shadow = fully visible (1.0)
            lightVisible = 1.0;
        }
        
        newVisibility += vec3(lightVisible);
        testsDone++;
        
        // Advance RNG
        b_rng = sampleRNG;
    }
    
    if (testsDone > 0)
    {
        newVisibility /= float(testsDone);
    }
    
    // Temporal accumulation
    float alpha = 1.0 / (b_sampleCount + 1.0);
    alpha = clamp(alpha, 0.05, 0.5); // 5-50% blend
    b_sampleCount += 1.0;
    
    vec3 finalVisibility = mix(prevVisibility, newVisibility, alpha);
    
    // Store results
    imageStore(shadowBuffer, l_pixelCoords, vec4(finalVisibility, float(b_sampleCount)));
    imageStore(randomBuffer, l_pixelCoords, uvec4(b_rng));
    
    // DEBUG: Show visibility as grayscale
    float avgVisibility = (finalVisibility.r + finalVisibility.g + finalVisibility.b) / 3.0;
    imageStore(o_framebufferTex, l_pixelCoords, vec4(vec3(avgVisibility), 1.0));
}