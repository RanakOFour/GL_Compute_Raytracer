#version 430 core
#extension GL_ARB_bindless_texture: require
#extension GL_ARB_gpu_shader_int64 : require

// Combined PBR Shading with Monte Carlo Stratified Shadow Sampling
// This shader integrates physically-based rendering with stratified shadow ray tracing
// for soft shadows with temporal accumulation.

layout(local_size_x = 8, local_size_y = 4) in;

layout(rgba32f, binding = 0) uniform image2D o_framebufferTex;

layout(rgba32f, binding = 1) uniform image2D hitLocations;
layout(rgba32f, binding = 2) uniform image2D triangleNormals;
layout(rgba32f, binding = 3) uniform image2D texMatInfo;
layout(rgba32f, binding = 4) uniform image2D shadowBuffer;
layout(rgba32f, binding = 5) uniform image2D prevFrameInfo;
layout(rgba32f, binding = 6) uniform image2D motionVectors;

struct Material
{
    vec3 albedo;
    float metallic;
    float roughness;
    float ambientOcclusion;
};

layout(std430, binding = 10) readonly buffer b_Materials
{
    Material materials[];
};

#define MAX_TEXTURES 10
layout(binding = 11) readonly buffer b_texSamplers
{
    uint64_t materialTextures[];
};

struct Triangle
{
    vec3 a;
    vec3 b;
    vec3 c;
    vec3 normal;

    vec2 uvA;
    vec2 uvB;
    vec2 uvC;

    int textureId;
    int materialId;
};

layout(std430, binding = 7) readonly buffer b_trianglesSSBO
{
    Triangle sceneTris[];
};

struct Node
{
    vec3 minBound;
    int leftFirst;
    vec3 maxBound;
    int triangleCount;
};

layout(std430, binding = 8) readonly buffer b_bvhNodes
{
    Node bvhNodes[];
};

layout(std430, binding = 9) readonly buffer b_bvhTriangleId
{
    int bvhTriIdxs[];
};

struct Camera
{
    vec3 position;
    vec3 forward;
    vec3 right;
    vec3 up;
    float fov;
};

uniform Camera u_camera;
uniform Camera u_lastFrameCamera;

struct Light
{
    vec3 position;
    vec3 colour;
    float intensity;

    float radius;

    vec3 cornerA;
    vec3 cornerB;
};

#define MAX_LIGHTS 10
uniform Light u_lights[MAX_LIGHTS];
uniform int u_lightCount;

uniform int u_frameCount;
uniform int u_sampleCount = 16;
uniform vec2 u_resolution;
uniform float u_aspect;

const float PI = 3.14159265359;

// ============================================================================
// Random Number Generation (LCG)
// ============================================================================
uint lcg(inout uint _seed)
{
    _seed = _seed * 1664525u + 1013904223u;
    uint hashed = _seed ^ (_seed >> 14);
    _seed = hashed;
    return _seed >> 8;
}

float RandomFloat(inout uint _seed)
{
    uint l_result = lcg(_seed);
    const float l_inv_max_int = 1.0f / 16777215.0f;
    return float(lcg(_seed)) * l_inv_max_int;
}

// ============================================================================
// PBR Functions (Cook-Torrance BRDF)
// ============================================================================
float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;

    float nom = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;

    return nom / denom;
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = (roughness + 1.0);
    float k = (r * r) / 8.0;

    float nom = NdotV;
    float denom = NdotV * (1.0 - k) + k;

    return nom / denom;
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    float ggx2 = GeometrySchlickGGX(NdotV, roughness);
    float ggx1 = GeometrySchlickGGX(NdotL, roughness);

    return ggx1 * ggx2;
}

vec3 fresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// ============================================================================
// Reprojection Utilities
// ============================================================================
vec2 WorldToNDC(vec3 _worldPos, in Camera _camera)
{
    vec3 l_viewDir = _worldPos - _camera.position;
    float l_depth = dot(l_viewDir, _camera.forward);

    if (l_depth <= 0.0)
    {
        return vec2(2.0, 2.0);
    }

    float l_tanHalfFOV = tan(_camera.fov * 0.5);

    float x = dot(l_viewDir, _camera.right);
    float y = dot(l_viewDir, _camera.up);

    return vec2(
        x / (l_depth * l_tanHalfFOV * u_aspect),
        y / (l_depth * l_tanHalfFOV)
    );
}

vec2 NDCToPixel(vec2 _coord)
{
    vec2 uv = _coord * 0.5 + 0.5;
    return uv * u_resolution;
}

ivec2 CalculateLastFramePosition(vec3 _worldPosition)
{
    vec2 l_prevNDC = WorldToNDC(_worldPosition, u_lastFrameCamera);

    if (abs(l_prevNDC.x) > 1.0f || abs(l_prevNDC.y) > 1.0f)
    {
        return ivec2(-1, -1);
    }

    vec2 l_prevPixel = NDCToPixel(l_prevNDC);
    l_prevPixel = clamp(l_prevPixel, vec2(0.0), u_resolution);

    return ivec2(l_prevPixel + 0.5);
}

// ============================================================================
// Stratified Sampling
// ============================================================================
vec3 StratifiedSampleSphere(inout uint _seed, vec3 _center, float _radius, int _currentSample)
{
    int l_gridSize = int(sqrt(float(u_sampleCount)));

    int l_stratumX = _currentSample % l_gridSize;
    int l_stratumY = _currentSample / l_gridSize;

    float l_jitterU = RandomFloat(_seed);
    float l_jitterV = RandomFloat(_seed);

    float u = (float(l_stratumX) + l_jitterU) / float(l_gridSize);
    float v = (float(l_stratumY) + l_jitterV) / float(l_gridSize);

    float phi = 2.0 * PI * u;
    float cosTheta = 1.0 - 2.0 * v;
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    vec3 dir = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
    return _center + dir * _radius;
}

vec3 StratifiedSamplePlane(inout uint _seed, vec3 _corner, vec3 _edge1, vec3 _edge2, int _currentSample)
{
    int l_gridSize = int(sqrt(float(u_sampleCount)));

    int l_stratumX = _currentSample % l_gridSize;
    int l_stratumY = _currentSample / l_gridSize;

    float l_jitterU = RandomFloat(_seed);
    float l_jitterV = RandomFloat(_seed);

    float u = (float(l_stratumX) + l_jitterU) / float(l_gridSize);
    float v = (float(l_stratumY) + l_jitterV) / float(l_gridSize);

    return _corner + (u * _edge1) + (v * _edge2);
}

// ============================================================================
// Ray Tracing Structures and Functions
// ============================================================================
struct Ray { vec3 origin; vec3 direction; };

struct RaycastResult
{
    float distance;
    vec3 position;
    vec3 normal;
};

bool TriangleIntersect(inout RaycastResult _result, Ray _ray, Triangle _tri, int _index)
{
    const float l_ep = 0.000001;

    vec3 l_edge1 = _tri.b - _tri.a;
    vec3 l_edge2 = _tri.c - _tri.a;

    vec3 h = cross(_ray.direction, l_edge2);
    float det = dot(l_edge1, h);

    if (det < l_ep)
    {
        return false;
    }

    float invDet = 1.0 / det;
    vec3 s = _ray.origin - _tri.a;
    float u = invDet * dot(s, h);

    if (u < 0.0 || u > 1.0)
    {
        return false;
    }

    vec3 q = cross(s, l_edge1);
    float v = invDet * dot(_ray.direction, q);

    if (v < 0.0 || u + v > 1.0)
    {
        return false;
    }

    float l_distance = invDet * dot(l_edge2, q);

    if (l_distance > l_ep && l_distance < _result.distance)
    {
        _result.position = _ray.origin + _ray.direction * l_distance;
        _result.distance = l_distance;
        _result.normal = normalize(cross(l_edge1, l_edge2));
        return true;
    }

    return false;
}

bool IntersectAABB(inout Ray _ray, vec3 _minBound, vec3 _maxBound)
{
    float tmin = 0.0f;
    float tmax = 10000000.0f;

    for (int i = 0; i < 3; i++)
    {
        if (abs(_ray.direction[i]) < 0.0001f)
        {
            if (_ray.origin[i] < _minBound[i] || _ray.origin[i] > _maxBound[i])
                return false;
        }
        else
        {
            float ood = 1.0f / _ray.direction[i];
            float t1 = (_minBound[i] - _ray.origin[i]) * ood;
            float t2 = (_maxBound[i] - _ray.origin[i]) * ood;

            if (t1 > t2)
            {
                float temp = t1;
                t1 = t2;
                t2 = temp;
            }

            tmin = max(tmin, t1);
            tmax = min(tmax, t2);

            if (tmin > tmax)
            {
                return false;
            }
        }
    }

    return true;
}

bool IsInShadow(inout RaycastResult _result, vec3 _origin, vec3 _direction, float _distance)
{
    Ray l_shadowRay;
    l_shadowRay.origin = _origin;
    l_shadowRay.direction = _direction;

    int l_indexStack[64];
    int l_top = 0;
    l_indexStack[l_top] = 0;

    Node l_node = bvhNodes[l_indexStack[l_top]];
    l_top++;

    do
    {
        if (IntersectAABB(l_shadowRay, l_node.minBound, l_node.maxBound))
        {
            if (l_node.triangleCount > 0)
            {
                for (int i = 0; i < l_node.triangleCount; i++)
                {
                    int triIdx = bvhTriIdxs[l_node.leftFirst + i];
                    if (TriangleIntersect(_result, l_shadowRay, sceneTris[triIdx], triIdx)
                        && _result.distance < _distance)
                    {
                        return true;
                    }
                }
            }
            else
            {
                l_indexStack[l_top] = l_node.leftFirst;
                l_top++;
                l_indexStack[l_top] = l_node.leftFirst + 1;
                l_top++;
            }
        }

        l_top--;
        l_node = bvhNodes[l_indexStack[l_top]];
    } while (l_top > -1);

    return false;
}

void main()
{
    ivec2 l_pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    // Initialize RNG
    uint l_rngState = uint(l_pixelCoords.x * 1973u + l_pixelCoords.y * 9277u + u_frameCount * 26699u);
    lcg(l_rngState);

    // Load hit data
    vec3 l_position = imageLoad(hitLocations, l_pixelCoords).xyz;
    float l_posDistance = imageLoad(hitLocations, l_pixelCoords).w;
    vec2 l_texUVs = imageLoad(texMatInfo, l_pixelCoords).rg;

    // Background - no hit
    if (l_posDistance == 1e30f)
    {
        imageStore(o_framebufferTex, l_pixelCoords, vec4(0.0, 0.1, 0.3, 1.0));
        imageStore(shadowBuffer, l_pixelCoords, vec4(1.0));
        return;
    }

    // Load texture and material info
    int l_texId = int(imageLoad(texMatInfo, l_pixelCoords).b);
    int l_matId = int(imageLoad(texMatInfo, l_pixelCoords).a);

    vec3 l_texColour = vec3(1.0);
    if (l_texId > -1)
    {
        l_texColour = texture(sampler2D(materialTextures[l_texId]), l_texUVs).rgb;
    }

    Material l_mat;
    if (l_matId > -1)
    {
        l_mat = materials[l_matId];
    }
    else
    {
        l_mat.albedo = vec3(1.0);
        l_mat.metallic = 1.0;
        l_mat.roughness = 0.0;
        l_mat.ambientOcclusion = 1.0;
    }

    vec3 l_normal = normalize(imageLoad(triangleNormals, l_pixelCoords).rgb);
    vec3 V = normalize(u_camera.position - l_position);

    // PBR setup
    vec3 F0 = mix(vec3(0.04), l_mat.albedo, l_mat.metallic);
    vec3 Lo = vec3(0.0f);

    float l_sqrtSamples = sqrt(u_sampleCount);

    // Process each light with stratified shadow sampling
    for (int i = 0; i < u_lightCount; i++)
    {
        vec3 l_lightContribution = vec3(0.0f);
        int l_visibleSamples = 0;

        // Stratified sampling loop
        for (int j = 0; j < int(l_sqrtSamples); j++)
        {
            for (int k = 0; k < int(l_sqrtSamples); k++)
            {
                int l_sampleIndex = j * int(l_sqrtSamples) + k;

                // Get stratified sample point on light
                vec3 l_samplePoint;
                if (u_lights[i].radius > 0.0)
                {
                    l_samplePoint = StratifiedSampleSphere(l_rngState, u_lights[i].position, u_lights[i].radius, l_sampleIndex);
                }
                else
                {
                    l_samplePoint = StratifiedSamplePlane(l_rngState, u_lights[i].position,
                                                          u_lights[i].cornerA - u_lights[i].position,
                                                          u_lights[i].cornerB - u_lights[i].position,
                                                          l_sampleIndex);
                }

                vec3 l_lightDir = l_samplePoint - l_position;
                float l_lightDistance = length(l_lightDir);
                l_lightDir = normalize(l_lightDir);

                // Shadow ray test
                RaycastResult l_shadowResult;
                l_shadowResult.distance = 1e30f;
                l_shadowResult.position = vec3(0.0f);

                if (IsInShadow(l_shadowResult, l_position + l_normal * 0.001, l_lightDir, l_lightDistance))
                {
                    continue; // In shadow, skip this sample
                }

                l_visibleSamples++;

                // Calculate PBR lighting for this sample
                vec3 l_halfLength = normalize(V + l_lightDir);
                float l_attenuation = 1.0 / (1.0 + 0.1 * l_lightDistance * l_lightDistance);
                vec3 l_radiance = u_lights[i].colour * u_lights[i].intensity * l_attenuation;

                // Cook-Torrance BRDF
                float NDF = DistributionGGX(l_normal, l_halfLength, l_mat.roughness);
                float G = GeometrySmith(l_normal, V, l_lightDir, l_mat.roughness);
                vec3 F = fresnelSchlick(clamp(dot(l_halfLength, V), 0.0, 1.0), F0);

                vec3 l_numerator = NDF * G * F;

                float NdotL = max(dot(l_normal, l_lightDir), 0.0f);
                float l_denom = 4.0 * max(dot(l_normal, V), 0.0) * NdotL + 0.001;
                vec3 l_specular = l_numerator / l_denom;

                vec3 kS = F;
                vec3 kD = vec3(1.0) - kS;
                kD *= 1.0 - l_mat.metallic;

                l_lightContribution += ((kD * l_mat.albedo) / PI + l_specular) * l_radiance * NdotL;
            }
        }

        // Average the contribution across all samples
        l_lightContribution /= float(u_sampleCount);
        Lo += l_lightContribution;
    }

    // Ambient lighting
    vec3 l_ambient = vec3(0.03) * l_mat.albedo * l_mat.ambientOcclusion;
    vec3 l_currentColour = (l_ambient + Lo) * l_texColour;

    // ========================================================================
    // Temporal Accumulation
    // ========================================================================
    float l_confidence = 1.0;

    ivec2 l_previousCoord = CalculateLastFramePosition(l_position);

    float l_oldDepth = imageLoad(prevFrameInfo, l_previousCoord).w;
    vec3 l_oldNormal = imageLoad(prevFrameInfo, l_previousCoord).xyz;

    vec4 l_motionData = imageLoad(motionVectors, l_pixelCoords);
    vec2 l_motionVector = l_motionData.xy;
    float l_motionValid = l_motionData.z;

    // Adjust confidence based on motion
    float l_motionLength = length(l_motionVector);
    float l_motionConfidence = exp(-l_motionLength * 10.0);
    l_confidence *= l_motionConfidence;

    int b_totalSampleCount = int(imageLoad(shadowBuffer, l_previousCoord).w);

    if (l_motionValid > 0.5)
    {
        float l_depthChange = abs(l_posDistance - l_oldDepth) / l_posDistance;

        if (l_depthChange > 0.05)
        {
            l_confidence *= 1.0 - mix(0.05, 0.4, l_depthChange);
        }

        float l_normalChange = 1.0f - dot(l_oldNormal, l_normal);

        if (l_normalChange > 0.2)
        {
            l_confidence *= 1.0 - mix(0.05, 0.3, l_normalChange);
        }

        if (l_confidence > 0.5)
        {
            // Accumulate with previous frame
            vec3 b_previousColour = imageLoad(shadowBuffer, l_previousCoord).xyz;

            b_totalSampleCount++;
            float l_alpha = 1.0 / float(b_totalSampleCount);
            l_alpha = clamp(l_alpha, 0.01, 0.1);

            l_currentColour = mix(b_previousColour, l_currentColour, l_alpha);
        }
        else
        {
            b_totalSampleCount = 1;
        }
    }
    else
    {
        b_totalSampleCount = 1;
    }

    // Store accumulated colour for next frame (before gamma correction)
    imageStore(shadowBuffer, l_pixelCoords, vec4(l_currentColour, b_totalSampleCount));

    // Store current frame info for next frame's reprojection
    imageStore(prevFrameInfo, l_pixelCoords, vec4(l_normal, l_posDistance));

    // Gamma correction for final output
    vec3 l_finalColour = pow(l_currentColour, vec3(1.0 / 2.2));

    imageStore(o_framebufferTex, l_pixelCoords, vec4(l_finalColour, 1.0f));
}
