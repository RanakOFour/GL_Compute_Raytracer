#version 430 core

layout(local_size_x = 8, local_size_y = 4) in;
layout(rgba32f, binding = 0) uniform image2D o_framebufferTex;

layout(rgba32f, binding = 1) uniform image2D intersectPositions;
layout(rgba32f, binding = 2) uniform image2D triangleNormals;
layout(r32f, binding = 6) uniform image2D shadowBuffer;


struct Triangle
{
    // Vertex positions
    vec3 a;
    vec3 b;
    vec3 c;
    vec3 normal;

    // UV Coordinates for each vertex
    vec2 uvA;
    vec2 uvB;
    vec2 uvC;

    int textureIndex;
    int materialIndex;
};

layout(std430, binding = 7) readonly buffer b_trianglesSSBO
{
    Triangle sceneTris[];
};


struct Node
{
    // Laid out like this for bit packing
    vec3 minBound;

    // Holds index of left node (if not leaf node) or first triangle (if leaf node)
    int leftFirst;
    vec3 maxBound;

    // Triangles in node (0 if not leaf node)
    int triangleCount;
};

layout(std430, binding = 8) readonly buffer b_bvhNodes
{
    Node bvhNodes[];
};

// Maps bvhNode.leftFirst indexes to indexes in sceneTris
layout(std430, binding = 9) readonly buffer b_bvhTriangleIndex
{
    int bvhTriIdxs[];
};

struct Light { vec3 position; vec3 color; };
#define MAX_LIGHTS 10
uniform Light u_lights[MAX_LIGHTS];
uniform int u_numLights;
uniform vec2 u_resolution;

struct Ray  { vec3 origin; vec3 direction; };

struct RaycastResult {
    bool hit;
    float distance;
    vec3 position;
    vec3 normal;
    int triangleIndex;
};

RaycastResult triangleIntersect(Ray _ray, Triangle _tri, int _index)
{
    RaycastResult result;
    result.hit = false;
    result.triangleIndex = _index;

    float l_ep = 0.0001;

    vec3 l_edgeAB = _tri.a;
    vec3 l_edgeAC = _tri.b; 
    vec3 l_edgeAP = _tri.c;

    vec3 edge1 = l_edgeAC - l_edgeAB;
    vec3 edge2 = l_edgeAP - l_edgeAB;
    vec3 ray_cross_edge2 = cross(_ray.direction, edge2);
    float det = dot(edge1, ray_cross_edge2);

    if(det > -l_ep && det < l_ep)
    {
        return result;
    }

    float inv_det = 1.0 / det;
    vec3 s = _ray.origin - l_edgeAB;
    float u = inv_det * dot(s, ray_cross_edge2);

    if(u < 0.0 || u > 1.0)
    {
        return result;
    }

    vec3 s_cross_e1 = cross(s, edge1);
    float v = inv_det * dot(_ray.direction, s_cross_e1);

    if(v < 0.0 || u + v > 1.0)
    {
        return result;
    }

    float t = inv_det * dot(edge2, s_cross_e1);

    if(t > l_ep)
    {
        result.hit = true;
        result.position = _ray.origin + _ray.direction * t;
        result.distance = t;
        result.normal = _tri.normal;
        return result;
    }

    return result;
}

bool IntersectAABB(inout Ray _ray, vec3 _minBound, vec3 _maxBound)
{
    float tmin = 0.0f;
    float tmax = 10000000.0f;

    for (int i = 0; i < 3; i++)
    {
        if (abs(_ray.direction[i]) < 0.0001f)
        {
            if (_ray.origin[i] < _minBound[i] || _ray.origin[i] > _maxBound[i])
                return false;
        }
        else
        {
            float ood = 1.0f / _ray.direction[i];
            float t1 = (_minBound[i] - _ray.origin[i]) * ood;
            float t2 = (_maxBound[i] - _ray.origin[i]) * ood;

            if (t1 > t2)
            {
                float temp = t1;
                t1 = t2;
                t2 = temp;
            }

            tmin = max(tmin, t1);
            tmax = min(tmax, t2);

            if (tmin > tmax)
            {
                return false;
            }
        }
    }

    return true;
}

// Shadow ray tracing (simplified version of TraverseBVH)
bool isInShadow(vec3 _lightPos, vec3 _position, vec3 _normal, int _idx)
{
    Ray l_shadowRay;
    l_shadowRay.origin = _position + _normal * 0.001;
    l_shadowRay.direction = normalize(_lightPos - _position);
    
    float l_lightDistance = length(_lightPos - _position);
    
    int l_indexStack[64];
    int l_top = 0;
    l_indexStack[l_top] = 0;

    Node l_node = bvhNodes[l_indexStack[l_top]];
    l_top++;

    do
    {
        if(IntersectAABB(l_shadowRay, l_node.minBound, l_node.maxBound))
        {
            if(l_node.triangleCount > 0)
            {
                for(int i = 0; i < l_node.triangleCount; i++)
                {
                    // Skip the same triangle
                    if(bvhTriIdxs[l_node.leftFirst + i] == _idx)
                    {
                        continue;
                    }

                    RaycastResult l_shadowHit = triangleIntersect(l_shadowRay, sceneTris[bvhTriIdxs[l_node.leftFirst + i]], bvhTriIdxs[l_node.leftFirst + i]);
                    
                    // More than a minimum value to ignore close sceneTris
                    if(l_shadowHit.hit && l_shadowHit.distance < l_lightDistance && l_shadowHit.distance > 0.01f)
                    {
                        return true;
                    }
                }
            }
            else
            {
                l_indexStack[l_top] = l_node.leftFirst;
                l_top++;
                l_indexStack[l_top] = l_node.leftFirst + 1;
                l_top++;
            }
        }

        l_top--;
        l_node = bvhNodes[l_indexStack[l_top]];
    } while(l_top > -1);

    return false;
}

void main() 
{
    ivec2 l_pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    vec2 l_texCoord = vec2(l_pixelCoords) / u_resolution;
    
    vec3 l_position = imageLoad(intersectPositions, l_pixelCoords).rgb;
    vec4 l_normalBVal = imageLoad(triangleNormals, l_pixelCoords);
    vec3 l_normal = l_normalBVal.rgb;
    int l_triIndex = int(l_normalBVal.a);
    
    if (length(l_position) < 0.001) {
        imageStore(shadowBuffer, l_pixelCoords, vec4(1.0)); // No shadow for background
        return;
    }
    
    // Check shadows for each light
    for(int i = 0; i < u_numLights; i++) {
        vec3 lightDir = normalize(u_lights[i].position - l_position);
        float lightDistance = length(u_lights[i].position - l_position);
        
        // Offset to avoid self-intersection
        vec3 shadowRayOrigin = l_position + l_normal * 0.001;
        
        if (isInShadow(u_lights[i].position, l_position, l_normal, l_triIndex)) {
            imageStore(shadowBuffer, l_pixelCoords, vec4(0.0));
        }
    }
    
    //imageStore(shadowBuffer, l_pixelCoords, vec4(shadowFactor, 0.0, 0.0, 0.0));
}