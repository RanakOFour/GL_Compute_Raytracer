#version 430 core

layout(local_size_x = 8, local_size_y = 4) in;
layout(rgba32f, binding = 0) uniform image2D o_framebufferTex;

layout(rgba32f, binding = 1) uniform image2D hitLocations;
layout(rgba32f, binding = 2) uniform image2D triangleNormals;

layout(rgba32f, binding = 4) uniform image2D shadowBuffer;


struct Triangle
{
    // Vertex positions
    vec3 a;
    vec3 b;
    vec3 c;
    vec3 normal;

    // UV Coordinates for each vertex
    vec2 uvA;
    vec2 uvB;
    vec2 uvC;

    int textureId;
    int materialId;
};

layout(std430, binding = 5) readonly buffer b_trianglesSSBO
{
    Triangle sceneTris[];
};

struct Node
{
    // Laid out like this for bit packing
    vec3 minBound;

    // Holds index of left node (if not leaf node) or first triangle (if leaf node)
    int leftFirst;
    vec3 maxBound;

    // Triangles in node (0 if not leaf node)
    int triangleCount;
};

layout(std430, binding = 6) readonly buffer b_bvhNodes
{
    Node bvhNodes[];
};

// Maps bvhNode.leftFirst indexes to indexes in sceneTris
layout(std430, binding = 7) readonly buffer b_bvhTriangleId
{
    int bvhTriIdxs[];
};

#define MAX_LIGHTS 10
struct Light
{
    vec3 points[4];
    vec3 colour;
    float intensity;
    float radius;
};

uniform Light u_lights[MAX_LIGHTS];
uniform int u_lightCount;

uniform int u_sampleCount;

uniform float u_time;

uniform int u_frameCount;

uniform float u_temporalDecay;

struct Ray  { vec3 origin; vec3 direction; };

struct RaycastResult {
    bool hit;
    float distance;
    vec3 position;
    vec3 normal;
    int triangleId;
};

const float PI = 3.14159265359;

// A "random" function I found in a stack overflow comment section
// Basically, the pattern between sequential values is too much to make
// to a person, so it may aswell be random
uint pcg_hash(uint seed)
{
  uint state = seed * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

// Used to advance the PCG state.
uint rand_pcg(inout uint rng_state)
{
  uint state = rng_state;
  rng_state = rng_state * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

// Returns a float in [0,1)
float rand01(inout uint rng_state)
{
    uint x = rand_pcg(rng_state);
    return float(x) / 4294967295.0;
}

vec3 samplePointOnSphere(inout uint rng_state, vec3 center, float radius)
{
    float u = (rand01(rng_state) - 0.5f) * 2.0f;
    float v = (rand01(rng_state) - 0.5f) * 2.0f;

    // Turn random numbers into cosine distribution
    float radial = length(u);
    float theta = 2.0 * PI * v;

    float x = radial * cos(theta);
    float y = radial * sin(theta);

    vec3 dir = normalize(vec3(x, y, length(1.0f - u)));
    return center + dir * radius;
}

vec3 samplePointOnPlane(inout uint rng_state, vec3 _corner, vec3 _edge1, vec3 _edge2)
{
    float u = rand01(rng_state);
    float v = rand01(rng_state);

    return _corner + u * _edge1 + v * _edge2;
}

RaycastResult TriangleIntersect(Ray _ray, Triangle _tri, int _index)
{
    RaycastResult result;
    result.hit = false;
    result.triangleId = _index;

    const float l_ep = 0.000001;
    
    vec3 edge1 = _tri.b - _tri.a;
    vec3 edge2 = _tri.c - _tri.a;
    
    vec3 h = cross(_ray.direction, edge2);
    float det = dot(edge1, h);
    
    // If the determinant is negative, the triangle is back-facing.
    if (det < l_ep)
    {
        return result;
    }
    
    float invDet = 1.0 / det;
    vec3 s = _ray.origin - _tri.a;
    float u = invDet * dot(s, h);
    
    if (u < 0.0 || u > 1.0)
    {
        return result;
    }
    
    vec3 q = cross(s, edge1);
    float v = invDet * dot(_ray.direction, q);
    
    if (v < 0.0 || u + v > 1.0)
    {
        return result;
    }
    
    // At this stage we can compute t to find out where
    // the intersection point is on the line
    float t = invDet * dot(edge2, q);
    
    if (t > l_ep) // Ray intersection
    {
        result.hit = true;
        result.position = _ray.origin + _ray.direction * t;
        result.distance = t;
        result.normal = normalize(cross(edge1, edge2));
        return result;
    }
    
    // This means that there is a line intersection but not a ray intersection
    return result;
}

bool IntersectAABB(inout Ray _ray, vec3 _minBound, vec3 _maxBound)
{
    float tmin = 0.0f;
    float tmax = 10000000.0f;

    for (int i = 0; i < 3; i++)
    {
        if (abs(_ray.direction[i]) < 0.0001f)
        {
            if (_ray.origin[i] < _minBound[i] || _ray.origin[i] > _maxBound[i])
                return false;
        }
        else
        {
            float ood = 1.0f / _ray.direction[i];
            float t1 = (_minBound[i] - _ray.origin[i]) * ood;
            float t2 = (_maxBound[i] - _ray.origin[i]) * ood;

            if (t1 > t2)
            {
                float temp = t1;
                t1 = t2;
                t2 = temp;
            }

            tmin = max(tmin, t1);
            tmax = min(tmax, t2);

            if (tmin > tmax)
            {
                return false;
            }
        }
    }

    return true;
}

// Shadow ray tracing (simplified version of TraverseBVH)
bool IsInShadow(vec3 _lightPos, vec3 _position, vec3 _normal, int _idx, inout vec3 _error)
{
    Ray l_shadowRay;
    l_shadowRay.origin = _position + _normal * 0.01;
    l_shadowRay.direction = normalize(_lightPos - _position);
    
    float l_lightDistance = length(_lightPos - _position);
    
    int l_indexStack[64];
    int l_top = 0;
    l_indexStack[l_top] = 0;

    Node l_node = bvhNodes[l_indexStack[l_top]];
    l_top++;

    do
    {
        if(IntersectAABB(l_shadowRay, l_node.minBound, l_node.maxBound))
        {
            _error += vec3(0.02, 0.0, 0.0);
            if(l_node.triangleCount > 0)
            {
                for(int i = 0; i < l_node.triangleCount; i++)
                {
                    _error += vec3(0.0, 0.0, 0.01);
                    int triIdx = bvhTriIdxs[l_node.leftFirst + i];
                    RaycastResult newResult = TriangleIntersect(l_shadowRay, sceneTris[triIdx], triIdx);
                    if(newResult.hit && newResult.distance < l_lightDistance)
                    {
                        _error += vec3(0.0, 0.5, 0.00);
                        return true;
                    }
                }
            }
            else
            {
                l_indexStack[l_top] = l_node.leftFirst;
                l_top++;
                l_indexStack[l_top] = l_node.leftFirst + 1;
                l_top++;
            }
        }

        
        l_top--;
        l_node = bvhNodes[l_indexStack[l_top]];
    } while(l_top > -1);

    return false;
}

void main() 
{
    vec3 l_error = vec3(0.0);
    ivec2 l_pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    
    vec3 l_hitLocation = imageLoad(hitLocations, l_pixelCoords).xyz;
    float l_hitDistance = imageLoad(hitLocations, l_pixelCoords).w;
    int l_triId = int(imageLoad(triangleNormals, l_pixelCoords).w);
    Triangle l_hitTriangle = sceneTris[l_triId];
    
    if (l_hitDistance < 0.001)
    {
        imageStore(shadowBuffer, l_pixelCoords, vec4(1.0)); // No shadow for background
        return;
    }
    
    vec3 l_totalLight = vec3(0.0);

    // Check shadows for each light
    for(int i = 0; i < u_lightCount; i++)
    {
        vec3 l_incomingLight = vec3(0.0f);

        uint seed = pcg_hash(uint(l_pixelCoords.x) + (uint(l_pixelCoords.y) << 16) + uint(i * 73856093u));
        seed ^= uint(u_time * 1000.0);
        uint rng = seed;

        for(int j = 0; j < u_sampleCount; j++)
        {
            // Lots of stuff going on, just get a random normalized position

            vec3 l_randomPoint = vec3(0.0f);
            float l_area;
            if(u_lights[i].radius > 0.0f)
            {
                l_randomPoint = samplePointOnSphere(rng, u_lights[i].points[0], u_lights[i].radius);
                l_area =  4.0 * PI * u_lights[i].radius * u_lights[i].radius;
            }
            else
            {
                vec3 l_edge1 = u_lights[i].points[1] - u_lights[i].points[0];
                vec3 l_edge2 = u_lights[i].points[2] - u_lights[i].points[0];
                l_randomPoint = samplePointOnPlane(rng, 
                                                   u_lights[i].points[0],
                                                   normalize(l_edge1),
                                                   normalize(l_edge2));
                l_area = length(l_edge1) * length(l_edge2);
            }
            
            vec3 lightDir = normalize(l_randomPoint - l_hitLocation);
            float lightDistance = length(l_randomPoint - l_hitLocation);

            if (IsInShadow(l_randomPoint, l_hitLocation, l_hitTriangle.normal, l_triId, l_error))
            {
                continue;
            }

            // Simple geometric falloff + scaling. Keep existing intensity/colour conventions.
            // Note: pdf for uniform sphere surface is 1/(4*pi*r^2) so multiplying by area (4*pi*r^2)
            // cancels the pdf when sampling uniformly on the sphere surface (hence the factor below).
            vec3 l_lightIntensity = u_lights[i].colour * u_lights[i].intensity * l_area / (lightDistance * lightDistance);

            l_incomingLight += l_lightIntensity;
        }

        l_incomingLight /= float(u_sampleCount);
        l_totalLight += l_incomingLight;
    }
    
    imageStore(shadowBuffer, l_pixelCoords, vec4(l_totalLight, 1.0f));
    imageStore(o_framebufferTex, l_pixelCoords, vec4(l_error, 1.0f));
}