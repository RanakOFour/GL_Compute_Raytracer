// Statistical shadows based on this paper
// https://boksajak.github.io/files/RTG1_RayTracedShadows.pdf

#version 430 core

layout(local_size_x = 8, local_size_y = 4) in;
layout(rgba32f, binding = 0) uniform image2D o_framebufferTex;

layout(rgba32f, binding = 1) uniform image2D hitLocations;
layout(rgba32f, binding = 2) uniform image2D triangleNormals;

layout(rgba32f, binding = 4) uniform image2D shadowBuffer;
layout(rgba32ui, binding = 5) uniform uimage2D randomBuffer;

// Shadow parameters
uniform float u_searchRadius = 0.1;
uniform float u_minVariance = 0.000001;
uniform int u_neighborCount = 8;
uniform float u_bias = 0.001;

struct Triangle
{
    vec3 a; vec3 b; vec3 c;
    vec3 normal;
    vec2 uvA; vec2 uvB; vec2 uvC;
    int textureId;
    int materialId;
};

layout(std430, binding = 6) readonly buffer b_trianglesSSBO
{
    Triangle sceneTris[];
};

struct Node
{
    vec3 minBound;
    int leftFirst;
    vec3 maxBound;
    int triangleCount;
};

layout(std430, binding = 7) readonly buffer b_bvhNodes
{
    Node bvhNodes[];
};

layout(std430, binding = 8) readonly buffer b_bvhTriangleId
{
    int bvhTriIdxs[];
};

#define MAX_LIGHTS 10
struct Light
{
    vec3 points[4];
    vec3 colour;
    float intensity;
    float radius;
};

uniform Light u_lights[MAX_LIGHTS];
uniform int u_lightCount;
uniform int u_frameCount;

struct Ray
{ vec3 origin; vec3 direction; };

struct RaycastResult
{
    bool hit;
    float distance;
    vec3 position;
    vec3 normal;
    int triangleId;
};

const float PI = 3.14159265359;


// Linear Congruential Generator
uint lcg(inout uint seed)
{
    seed = (1664525u * seed + 1013904223u);
    return seed;
}

float RandomFloat(inout uint seed)
{
    return float(lcg(seed)) / 4294967295.0;
}

vec3 RandomPointOnSphere(inout uint seed, vec3 center, float radius)
{
    // Uniform random point on sphere using Marsaglia's method
    vec3 point;
    do
    {
        point = vec3(
            RandomFloat(seed) * 2.0 - 1.0,
            RandomFloat(seed) * 2.0 - 1.0,
            RandomFloat(seed) * 2.0 - 1.0
        );
    } while (dot(point, point) > 1.0);
    return center + normalize(point) * radius;
}

vec3 RandomPointOnPlane(inout uint seed, vec3 origin, vec3 edge1, vec3 edge2)
{
    float u = RandomFloat(seed);
    float v = RandomFloat(seed);
    return origin + edge1 * u + edge2 * v;
}

// ================== STATISTICAL SHADOW FUNCTIONS ==================

// Chebyshev's inequality for variance shadow estimation
float ChebyshevUpperBound(float moment1, float moment2, float t)
{
    // t is the current depth
    // moment1 is the mean (M1)
    // moment2 is the mean of squares (M2)
    
    if (t <= moment1)
    {
        // Surface is in front of the mean -> fully lit
        return 1.0;
    }
    
    float variance = max(moment2 - moment1 * moment1, u_minVariance);
    float d = t - moment1;
    float p_max = variance / (variance + d * d);
    
    return clamp(p_max, 0.0, 1.0);
}

RaycastResult TriangleIntersect(Ray _ray, Triangle _tri, int _index)
{
    RaycastResult result;
    result.hit = false;
    result.triangleId = _index;

    const float l_ep = 0.000001;
    
    vec3 edge1 = _tri.b - _tri.a;
    vec3 edge2 = _tri.c - _tri.a;
    
    vec3 h = cross(_ray.direction, edge2);
    float det = dot(edge1, h);
    
    // If the determinant is negative, the triangle is back-facing.
    if (det < l_ep)
    {
        return result;
    }
    
    float invDet = 1.0 / det;
    vec3 s = _ray.origin - _tri.a;
    float u = invDet * dot(s, h);
    
    if (u < 0.0 || u > 1.0)
    {
        return result;
    }
    
    vec3 q = cross(s, edge1);
    float v = invDet * dot(_ray.direction, q);
    
    if (v < 0.0 || u + v > 1.0)
    {
        return result;
    }
    
    // At this stage we can compute t to find out where
    // the intersection point is on the line
    float t = invDet * dot(edge2, q);
    
    if (t > l_ep) // Ray intersection
    {
        result.hit = true;
        result.position = _ray.origin + _ray.direction * t;
        result.distance = t;
        result.normal = normalize(cross(edge1, edge2));
        return result;
    }
    
    // This means that there is a line intersection but not a ray intersection
    return result;
}

bool IntersectAABB(inout Ray _ray, vec3 _minBound, vec3 _maxBound)
{
    float tmin = 0.0f;
    float tmax = 10000000.0f;

    for (int i = 0; i < 3; i++)
    {
        if (abs(_ray.direction[i]) < 0.0001f)
        {
            if (_ray.origin[i] < _minBound[i] || _ray.origin[i] > _maxBound[i])
                return false;
        }
        else
        {
            float ood = 1.0f / _ray.direction[i];
            float t1 = (_minBound[i] - _ray.origin[i]) * ood;
            float t2 = (_maxBound[i] - _ray.origin[i]) * ood;

            if (t1 > t2)
            {
                float temp = t1;
                t1 = t2;
                t2 = temp;
            }

            tmin = max(tmin, t1);
            tmax = min(tmax, t2);

            if (tmin > tmax)
            {
                return false;
            }
        }
    }

    return true;
}

// Single ray trace for depth value
float TraceShadowRay(vec3 origin, vec3 direction, float maxDistance)
{
    Ray ray;
    ray.origin = origin;
    ray.direction = direction;
    
    float closestHit = maxDistance;
    
    int stack[64];
    int stackPtr = 0;
    stack[stackPtr++] = 0;
    
    while (stackPtr > 0)
    {
        int nodeIdx = stack[--stackPtr];
        Node node = bvhNodes[nodeIdx];
        
        if (IntersectAABB(ray, node.minBound, node.maxBound))
        {
            if (node.triangleCount > 0)
            {
                // Leaf node - check triangles
                for (int i = 0; i < node.triangleCount; i++)
                {
                    int l_triId = bvhTriIdxs[node.leftFirst + i];
                    RaycastResult l_result = TriangleIntersect(ray, sceneTris[l_triId], l_triId);

                    if(l_result.hit && l_result.distance < closestHit)
                    {
                        closestHit = l_result.distance;
                    }
                }
            }
            else
            {
                // Interior node - push children
                stack[stackPtr++] = node.leftFirst;
                stack[stackPtr++] = node.leftFirst + 1;
            }
        }
    }
    
    return closestHit;
}

// Gather neighboring depth moments for statistical estimation
vec2 GatherDepthMoments(vec3 worldPos, vec3 normal, vec3 lightDir, float lightDistance, inout uint rngState)
{
    vec2 moments = vec2(0.0);
    float weightSum = 0.0;
    
    // Sample random points within search radius
    for (int i = 0; i < u_neighborCount; i++)
    {
        // Generate random offset within search radius
        vec2 offset = vec2(
            RandomFloat(rngState) * 2.0 - 1.0,
            RandomFloat(rngState) * 2.0 - 1.0
        );
        
        if (dot(offset, offset) > 1.0)
        {
            i--; // Rejection sampling
            continue;
        }
        
        offset *= u_searchRadius / lightDistance;
        
        // Jittered ray direction
        vec3 jitteredDir = normalize(lightDir + 
                                     vec3(offset.x, offset.y, 0.0) * 
                                     (1.0 - abs(dot(normal, lightDir))));
        
        // Trace to get depth
        float depth = TraceShadowRay(worldPos + normal * u_bias, 
                                    jitteredDir, lightDistance);
        
        // Convert to light space depth (0 at light, 1 at surface)
        float lightSpaceDepth = depth / lightDistance;
        
        // Weight by cosine between normal and light direction
        float weight = max(dot(normal, jitteredDir), 0.0);
        
        // Exponential moving average for moments
        moments += vec2(lightSpaceDepth, lightSpaceDepth * lightSpaceDepth) * weight;
        weightSum += weight;
    }
    
    if (weightSum > 0.0)
    {
        moments /= weightSum;
    }
    
    return moments;
}

void main()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    
    // Initialize RNG
    uint rngState = uint(pixelCoords.x * 1973 + pixelCoords.y * 9277 + u_frameCount * 26699);
    
    // Load hit data
    vec4 hitData = imageLoad(hitLocations, pixelCoords);
    vec3 hitLocation = hitData.xyz;
    float hitDistance = hitData.w;
    
    vec4 normalData = imageLoad(triangleNormals, pixelCoords);
    vec3 normal = normalData.xyz;
    int triId = int(normalData.w);
    
    if (hitDistance < 0.001)
    {
        imageStore(shadowBuffer, pixelCoords, vec4(1.0));
        return;
    }
    
    // Load previous shadow result and sample count
    vec4 prevShadowData = imageLoad(shadowBuffer, pixelCoords);
    vec3 prevShadow = prevShadowData.xyz;
    int totalSamples = int(prevShadowData.w);
    
    float shadowFactor = 0.0;
    int validLights = 0;
    
    // Process each light
    for (int lightIdx = 0; lightIdx < u_lightCount; lightIdx++)
    {
        Light light = u_lights[lightIdx];
        vec3 lightPos = light.points[0];
        
        // Calculate light direction and distance
        vec3 lightDir = lightPos - hitLocation;
        float lightDistance = length(lightDir);
        lightDir = normalize(lightDir);
        
        // Skip if light is behind surface
        float NdotL = dot(normal, lightDir);
        if (NdotL <= 0.0)
        {
            continue;
        }
        
        // Gather statistical depth moments
        vec2 moments = GatherDepthMoments(hitLocation, normal, lightDir, 
                                         lightDistance, rngState);
        
        // Current depth in light space (0 = at light, 1 = at surface)
        float currentDepth = 1.0; // We're at the surface
        
        // Apply Chebyshev's inequality
        float visibility = ChebyshevUpperBound(moments.x, moments.y, currentDepth);
        
        // Apply distance attenuation (optional)
        float attenuation = 1.0 / (1.0 + 0.1 * lightDistance * lightDistance);
        
        shadowFactor += visibility * attenuation * light.intensity * NdotL;
        validLights++;
    }
    
    // Average over lights
    if (validLights > 0)
    {
        shadowFactor /= float(validLights);
    }
    else
    {
        shadowFactor = 0.0;
    }
    
    // Temporal accumulation
    totalSamples++;
    float alpha = 1.0 / float(totalSamples);
    alpha = clamp(alpha, 0.01, 0.1);
    
    shadowFactor = mix(prevShadow.x, shadowFactor, alpha);
    
    // Store results
    imageStore(shadowBuffer, pixelCoords, vec4(vec3(shadowFactor), float(totalSamples)));
    
    // Store random state for next frame
    uvec4 randomState = uvec4(
                              rngState, 
                              rngState * 1664525u, 
                              rngState * 1103515245u,
                              rngState * 214013u
                             );

    imageStore(randomBuffer, pixelCoords, randomState);
}