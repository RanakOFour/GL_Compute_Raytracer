#version 430 core

layout(local_size_x = 1, local_size_y = 1) in;
layout(rgba32f, binding = 0) uniform image2D framebufferTex;

struct Triangle
{
    vec3 a;
    vec3 b;
    vec3 c;
    vec3 normal;
};

struct Node
{
    vec3 minBound;
    int leftFirst;
    vec3 maxBound;
    int triCount;
};

layout(std430, binding = 1) readonly buffer b_sceneTris
{
    Triangle sceneTris[];
};

layout(std430, binding = 2) readonly buffer b_bvhTriIndxs
{
    int bvhTriIdx[];
};

layout(std430, binding = 3) readonly buffer b_bvhNodes
{
    Node bvhNodes[];
};

struct Camera
{
    vec3 position;
    vec3 forward;
    vec3 right;
    vec3 up;
    float fov;
};

uniform Camera u_camera;

uniform vec2 resolution;

struct Light
{
    vec3 color;
    vec3 position;
};

#define MAX_LIGHTS 10
uniform Light lights[MAX_LIGHTS];
uniform int numLights;

struct Ray 
{
    vec3 origin;
    vec3 direction;
    vec3 recipDir;
};

struct RaycastResult 
{
    bool hit;
    float distance;
    vec3 position;
    vec3 normal;
    int triangleIndex;
};

RaycastResult triangleIntersect(inout Ray _ray, in Triangle _tri, int _index)
{
    RaycastResult result;
    result.hit = false;
    result.triangleIndex = _index;

    float l_ep = 0.0001;

    vec3 v0 = _tri.a;
    vec3 v1 = _tri.b; 
    vec3 v2 = _tri.c;

    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 ray_cross_edge2 = cross(_ray.direction, edge2);
    float det = dot(edge1, ray_cross_edge2);

    if(det > -l_ep && det < l_ep)
    {
        return result;
    }

    float inv_det = 1.0 / det;
    vec3 s = _ray.origin - v0;
    float u = inv_det * dot(s, ray_cross_edge2);

    if(u < 0.0 || u > 1.0)
    {
        return result;
    }

    vec3 s_cross_e1 = cross(s, edge1);
    float v = inv_det * dot(_ray.direction, s_cross_e1);

    if(v < 0.0 || u + v > 1.0)
    {
        return result;
    }

    float t = inv_det * dot(edge2, s_cross_e1);

    if(t > l_ep)
    {
        result.hit = true;
        result.position = _ray.origin + _ray.direction * t;
        result.distance = t;
        result.normal = _tri.normal;
        return result;
    }

    return result;
}

//Returns distance to cube or 1e30f if miss
float IntersectAABB(in RaycastResult _result, in Ray _ray, vec3 _minBound, vec3 _maxBound)
{
    float tx1 = (_minBound.x - _ray.origin.x) * _ray.recipDir.x, tx2 = (_maxBound.x - _ray.origin.x) * _ray.recipDir.x;
    float tmin = min( tx1, tx2 ), tmax = max( tx1, tx2 );
    float ty1 = (_minBound.y - _ray.origin.y) * _ray.recipDir.y, ty2 = (_maxBound.y - _ray.origin.y) * _ray.recipDir.y;
    tmin = max( tmin, min( ty1, ty2 ) ), tmax = min( tmax, max( ty1, ty2 ) );
    float tz1 = (_minBound.z - _ray.origin.z) * _ray.recipDir.z, tz2 = (_maxBound.z - _ray.origin.z) * _ray.recipDir.z;
    tmin = max( tmin, min( tz1, tz2 ) ), tmax = min( tmax, max( tz1, tz2 ) );
    if (tmax >= tmin && tmin < _result.distance && tmax > 0) return tmin; else return 1e30f;
}


RaycastResult TraverseBVH(in RaycastResult _result, inout Ray _ray)
{
    int l_indexStack[64];
    int l_top = 0;
    l_indexStack[l_top] = 0;

    Node l_node = bvhNodes[l_indexStack[l_top]];
    l_top++;

    while(true)
    {
        if(l_node.triCount > 0)
        {
            for(int i = 0; i < l_node.triCount; i++)
            {
                RaycastResult newResult = triangleIntersect(_ray, sceneTris[bvhTriIdx[l_node.leftFirst + i]], bvhTriIdx[l_node.leftFirst + i]);
                if(newResult.hit && newResult.distance < _result.distance)
                {
                    _result = newResult;
                }
            }

            if(l_top == 0)
            {
                break;
            }
            
            l_top--;
            l_node = bvhNodes[l_top];

            continue;
        }

        Node l_child1 = bvhNodes[l_node.leftFirst];
        Node l_child2 = bvhNodes[l_node.leftFirst + 1];

        float l_dist1 = IntersectAABB(_result, _ray, l_child1.minBound, l_child1.maxBound);
        float l_dist2 = IntersectAABB(_result, _ray, l_child2.minBound, l_child2.maxBound);

        if(l_dist1 > l_dist2)
        {
            float tempF = l_dist1;
            l_dist1 = l_dist2;
            l_dist2 = tempF;

            Node tempN = l_child1;
            l_child1 = l_child2;
            l_child2 = tempN;
        }

        if(l_dist1> 1e30f)
        {
            if(l_top == 0)
            {
                break;
            }


            l_top--;
            l_node = bvhNodes[l_indexStack[l_top]];
        }
        else
        {
            l_node = l_child1;
            if(l_dist2 != 1e30f)
            {
                l_indexStack[l_top] = l_node.leftFirst + 1;
                l_top++;
            }
        }
    }

    return _result;
}

bool isInShadow(vec3 _lightPos, RaycastResult _raycastHit)
{
    Ray l_shadowRay;
    l_shadowRay.origin = _raycastHit.position + _raycastHit.normal * 0.001;
    l_shadowRay.direction = normalize(_lightPos - _raycastHit.position);
    l_shadowRay.recipDir = 1 / l_shadowRay.direction;
    
    float l_lightDistance = length(_lightPos - _raycastHit.position);
    
    int l_indexStack[64];
    int l_top = 0;
    l_indexStack[l_top] = 0;

    Node l_node = bvhNodes[l_indexStack[l_top]];
    l_top++;

    while(true)
    {
        if(l_node.triCount > 0)
        {
            for(int i = 0; i < l_node.triCount; i++)
            {
                if(bvhTriIdx[l_node.leftFirst + i] == _raycastHit.triangleIndex)
                {
                    continue;
                }

                RaycastResult l_shadowResult = triangleIntersect(l_shadowRay, sceneTris[bvhTriIdx[l_node.leftFirst + i]], bvhTriIdx[l_node.leftFirst + i]);
                if(l_shadowResult.hit && l_shadowResult.distance < l_lightDistance && l_shadowResult.distance > 0.01f)
                {
                    return true;
                }
            }

            if(l_top == 0)
            {
                break;
            }
            
            l_top--;
            l_node = bvhNodes[l_top];
        }

        Node l_child1 = bvhNodes[l_node.leftFirst];
        Node l_child2 = bvhNodes[l_node.leftFirst + 1];

        float l_dist1 = IntersectAABB(_raycastHit, l_shadowRay, l_child1.minBound, l_child1.maxBound);
        float l_dist2 = IntersectAABB(_raycastHit, l_shadowRay, l_child2.minBound, l_child2.maxBound);

        if(l_dist1 > l_dist2)
        {
            float tempF = l_dist1;
            l_dist1 = l_dist2;
            l_dist2 = tempF;

            Node tempN = l_child1;
            l_child1 = l_child2;
            l_child2 = tempN;
        }

        if(l_dist1 > 1e30f)
        {
            if(l_top == 0)
            {
                break;
            }


            l_top--;
            l_node = bvhNodes[l_indexStack[l_top]];
        }
        else
        {
            if(l_dist2 != 1e30f)
            {
                l_top++;
                l_indexStack[l_top] = l_node.leftFirst + 1;
            }
            l_node = l_child1;
        }
    }

    return false;
}


vec3 getObjectColor(RaycastResult hit)
{
    //return normalize(vec3(3.0f - hit.distance));
    return vec3(1.0, 0.0, 0.0);
}

vec3 calculateShading(RaycastResult hit, Ray _ray)
{
    if (!hit.hit)
    {
        return vec3(0.1, 0.1, 0.3); // Background color
    }
    
    vec3 objectColor = getObjectColor(hit);

    return objectColor;

    vec3 lighting = vec3(0.0);

    // Flip normal if it's facing away from the ray (backface)
    vec3 normal = hit.normal;
    if(dot(normal, _ray.direction) > 0.0)
    {
        normal = -normal;
    }

    for(int i = 0; i < numLights; i++)
    {
        // Check if point is in shadow for this light
        if (isInShadow(lights[i].position, hit))
        {
            continue;
        }
        
        // Calculate direction from hit point to light
        vec3 lightDir = normalize(lights[i].position - hit.position);

        // Diffuse component
        float diffuse = max(dot(normal, lightDir), 0.0);
        vec3 diffuseColor = lights[i].color * objectColor * diffuse;

        // Specular component
        vec3 viewDir = normalize(u_camera.position - hit.position);
        vec3 reflectDir = reflect(-lightDir, normal);
        float specular = pow(max(dot(viewDir, reflectDir), 0.0), 32.0);
        vec3 specularColor = lights[i].color * specular;

        // Add attenuation based on distance
        float distance = length(lights[i].position - hit.position);
        float attenuation = 1.0 / (1.0 + 0.1 * distance + 0.01 * distance * distance);
        
        lighting += (diffuseColor + specularColor) * attenuation;
    };
    
    // Add ambient lighting (always present, even in shadows)
    vec3 ambient = objectColor * 0.1;
    
    return ambient + lighting;
}

void main() 
{
    vec2 uv = vec2(((float(gl_GlobalInvocationID.x) / gl_NumWorkGroups.x) - 0.5) * 2.0,
                   ((float(gl_GlobalInvocationID.y) / gl_NumWorkGroups.y) - 0.5) * 2.0);

    float aspect = float(gl_NumWorkGroups.x) / float(gl_NumWorkGroups.y);
    vec3 rayDir = normalize(u_camera.forward + 
                           uv.x * u_camera.right * aspect + 
                           uv.y * u_camera.up);
    
    Ray _ray;
    _ray.origin = u_camera.position;
    _ray.direction = rayDir;
    _ray.recipDir = 1 / rayDir;
    
    RaycastResult closestHit;
    closestHit.hit = false;
    closestHit.distance = 1e10;
    closestHit.normal = vec3(0.0);

    #if 0
    for(int i = 0; i < sceneTris.length(); i++)
    {
        RaycastResult newResult = triangleIntersect(_ray, sceneTris[i], i);
        if(newResult.hit && newResult.distance < closestHit.distance)
        {
            closestHit = newResult;
            //_result.normal.y += 0.05;
        }
    }
    #else
    TraverseBVH(closestHit, _ray);
    #endif

    vec3 color = calculateShading(closestHit, _ray);
    //color = closestHit.normal;

    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    imageStore(framebufferTex, position, vec4(color, 1.0));
}