79 {\cf17 inline} Model::Model({\cf17 const} std::string& _path) :\par
80     m_dirty(false)\par
81   , m_position()\par
82   , m_ssboId(0)\par
83 \{\par
84   std::vector<glm::vec3> L_positions;\par
85   std::vector<glm::vec2> L_tcs;\par
86   std::vector<glm::vec3> L_normals;\par
87   std::string L_currentline;\par
88 \par
89   std::ifstream file(_path.c_str());\par
90 \par
91   {\cf19 if}(!file.is_open())\par
92   \{\par
93     {\cf19 throw} std::runtime_error({\cf22 "Failed to open model ["} + _path + {\cf22 "]"});\par
94   \}\par
95 \par
96   {\cf19 while}(!file.eof())\par
97   \{\par
98     std::getline(file, L_currentline);\par
99     {\cf19 if}(L_currentline.length() < 1) {\cf19 continue};\par
100 \par
101     std::vector<std::string> L_tokens;\par
102     SplitStringWhitespace(L_currentline, L_tokens);\par
103     {\cf19 if}(L_tokens.size() < 1) {\cf19 continue};\par
104 \par
105     {\cf19 if}(L_tokens.at(0) == {\cf22 "v"} && L_tokens.size() >= 4)\par
106     \{\par
107       glm::vec3 p(atof(L_tokens.at(1).c_str()),\par
108         atof(L_tokens.at(2).c_str()),\par
109         atof(L_tokens.at(3).c_str()));\par
110 \par
111       L_positions.push_back(p);\par
112     \}\par
113     {\cf19 else} {\cf19 if}(L_tokens.at(0) == {\cf22 "vt"} && L_tokens.size() >= 3)\par
114     \{\par
115       glm::vec2 tc(atof(L_tokens.at(1).c_str()),\par
116         1.0f - atof(L_tokens.at(2).c_str()));\par
117 \par
118       L_tcs.push_back(tc);\par
119     \}\par
120     {\cf19 else} {\cf19 if}(L_tokens.at(0) == {\cf22 "vn"} && L_tokens.size() >= 4)\par
121     \{\par
122       glm::vec3 n(atof(L_tokens.at(1).c_str()),\par
123         atof(L_tokens.at(2).c_str()),\par
124         atof(L_tokens.at(3).c_str()));\par
125 \par
126       L_normals.push_back(n);\par
127     \}\par
128     {\cf19 else} {\cf19 if}(L_tokens.at(0) == {\cf22 "f"} && L_tokens.size() >= 4)\par
129     \{\par
130       Face f;\par
131       std::vector<std::string> sub;\par
132       SplitString(L_tokens.at(1), {\cf23 '/'}, sub);\par
133       {\cf19 if}(sub.size() >= 1) f.a.position = L_positions.at(atoi(sub.at(0).c_str()) - 1);\par
134       {\cf19 if}(sub.size() >= 2) f.a.texcoord = L_tcs.at(atoi(sub.at(1).c_str()) - 1);\par
135       {\cf19 if}(sub.size() >= 3) f.a.normal = L_normals.at(atoi(sub.at(2).c_str()) - 1);\par
136 \par
137       {\cf19 for}({\cf18 size_t} ti = 2; ti + 1 < L_tokens.size(); ti++)\par
138       \{\par
139         SplitString(L_tokens.at(ti), {\cf23 '/'}, sub);\par
140         {\cf19 if}(sub.size() >= 1) f.b.position = L_positions.at(atoi(sub.at(0).c_str()) - 1);\par
141         {\cf19 if}(sub.size() >= 2) f.b.texcoord = L_tcs.at(atoi(sub.at(1).c_str()) - 1);\par
142         {\cf19 if}(sub.size() >= 3) f.b.normal = L_normals.at(atoi(sub.at(2).c_str()) - 1);\par
143 \par
144         SplitString(L_tokens.at(ti + 1), {\cf23 '/'}, sub);\par
145         {\cf19 if}(sub.size() >= 1) f.c.position = L_positions.at(atoi(sub.at(0).c_str()) - 1);\par
146         {\cf19 if}(sub.size() >= 2) f.c.texcoord = L_tcs.at(atoi(sub.at(1).c_str()) - 1);\par
147         {\cf19 if}(sub.size() >= 3) f.c.normal = L_normals.at(atoi(sub.at(2).c_str()) - 1);\par
148 \par
149         f.CalculateNormal();\par
150         m_faces.push_back(f);\par
151         m_dirty = {\cf17 true};\par
152       \}\par
153     \}\par
154   \}\par
155 \}\par
