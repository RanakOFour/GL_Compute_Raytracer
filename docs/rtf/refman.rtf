215 \par
216   _output.clear();\par
217 \par
218   {\cf19 for}({\cf18 size_t} i = 0; i < _input.length(); i++)\par
219   \{\par
220     {\cf19 if}(_input.at(i) == _splitter)\par
221     \{\par
222       _output.push_back(curr);\par
223       curr = {\cf22 ""};\par
224     \}\par
225     {\cf19 else}\par
