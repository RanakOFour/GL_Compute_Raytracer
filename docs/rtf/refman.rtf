179 {\cf17 inline} {\cf18 void} Model::SplitStringWhitespace({\cf17 const} std::string& _input,\par
180   std::vector<std::string>& _output)\par
181 \{\par
182   std::string curr;\par
183 \par
184   _output.clear();\par
185 \par
186   {\cf19 for}({\cf18 size_t} i = 0; i < _input.length(); i++)\par
187   \{\par
188     {\cf19 if}(_input.at(i) == {\cf23 ' '} ||\par
189       _input.at(i) == {\cf23 '\\r'} ||\par
190       _input.at(i) == {\cf23 '\\n'} ||\par
191       _input.at(i) == {\cf23 '\\t'})\par
192     \{\par
193       {\cf19 if}(curr.length() > 0)\par
194       \{\par
195         _output.push_back(curr);\par
196         curr = {\cf22 ""};\par
197       \}\par
198     \}\par
199     {\cf19 else}\par
200     \{\par
201       curr += _input.at(i);\par
202     \}\par
203   \}\par
204 \par
205   {\cf19 if}(curr.length() > 0)\par
206   \{\par
207     _output.push_back(curr);\par
208   \}\par
209 \}\par
210 \par
