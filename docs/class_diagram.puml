        + SetUniform(name, value : float) : void
        + SetUniform(name, value : glm::vec2) : void
        + SetUniform(name, value : glm::vec3) : void
        + SetUniform(name, value : glm::vec4) : void
        + SetUniform(name, value : glm::uvec4) : void
        + GetID() : GLuint
    }

    class ShaderInfo {
        - m_name : std::string
        - m_properties : std::vector<ShaderProperty>
        - m_shader : ComputeShader*
        - m_enabled : bool
        --
        + ShaderInfo(name, shader)
