        + UpdateShader() : void
        + Enabled() : bool
        + Enabled(e : bool) : void
        + GetProperties() : std::vector<ShaderProperty>&
        + GetVisibleProperties() : std::vector<ShaderProperty*>
        + RefreshPropertyVisibility() : void
        + SetPropertyVisibility(name, visible) : bool
        + GetProperty(name) : ShaderProperty*
