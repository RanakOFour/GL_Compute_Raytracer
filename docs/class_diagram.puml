        - m_nodes : std::vector<BVHNode>
        - m_planeCount : int
        --
        - UpdateNodeBounds(nodeIndex) : void
        - CalculateSAH(node, axis, pos) : float
        - FindBestSplitPlane(node, bestAxis, bestPos) : float
        - CalcNodeCost(node) : float
        - Subdivide(nodeIndex) : void
        --
        + BVH()
        + BVH(tris : std::vector<Triangle>*)
        + ~BVH()
        + PlaneCount(planes) : void
        + PlaneCount() : int
        + BuildBHV(tris) : void
